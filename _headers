# Cloudflare Pages headers.
#
# The CSP is the privacy claim expressed as policy: this page may not connect
# anywhere. `connect-src 'none'` blocks fetch, XHR, WebSocket and sendBeacon at
# the browser level, so the in-page ledger is belt-and-braces rather than the
# only guarantee. script-src stays permissive so that an agent host injecting a
# script into the page is never blocked by our own hardening.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()
